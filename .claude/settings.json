{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Edit(projects/**)",
      "Bash(python3 scripts/project.py *)",
      "Bash(python3 scripts/claims.py *)",
      "Bash(python3 scripts/fetch_source.py *)",
      "Bash(python3 scripts/verify_claims.py *)",
      "Bash(python3 scripts/verify_claims.py)",
      "Bash(python3 scripts/promise_lint.py *)",
      "Bash(python3 scripts/promise_lint.py)",
      "Bash(python3 scripts/cost_report.py *)",
      "Bash(python3 scripts/cost_report.py)",
      "Bash(python3 scripts/compare.py *)",
      "Bash(python3 scripts/compare.py)",
      "Bash(python3 scripts/revisit.py *)",
      "Bash(python3 scripts/revisit.py)",
      "Bash(python3 scripts/research_log.py *)",
      "Bash(python3 scripts/decision_lint.py *)",
      "Bash(python3 scripts/decision_lint.py)",
      "Bash(python3 scripts/estimate.py *)",
      "Bash(python3 scripts/revise.py *)",
      "Bash(python3 -m unittest discover -s tests)",
      "Bash(python3 -m unittest discover -s tests -v)",
      "Bash(python3 -m unittest discover -s tests -p *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(uvx markitdown *)"
    ],
    "ask": [
      "Bash(python3 scripts/claims.py human-verified *)",
      "Bash(python3 scripts/project.py approve-plan*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(./.env.*)",
      "Edit(brief/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Edit(projects/**/CLAUDE.md)",
      "Edit(projects/**/AGENTS.md)",
      "Edit(projects/**/.claude/**)",
      "Edit(projects/**/.cursor/**)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(**/.mcp.json)",
      "Bash(python3 scripts/fetch_source.py --rebuild-manifest*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/session_start.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/cost_ledger.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_instructions.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|Read|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/mark_untrusted.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/stage_gate.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/cost_ledger.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/cost_ledger.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/cost_ledger.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/statusline.py\""
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "python3 scripts/fetch_source.py *",
      "python3 scripts/claims.py human-verified *",
      "python3 scripts/project.py approve-plan*",
      "uvx markitdown *"
    ],
    "filesystem": {
      "denyWrite": [
        "./AGENTS.md",
        "./CLAUDE.md",
        "./README.md",
        "./.gitignore",
        "./.gitattributes",
        "./.claude",
        "./.cursor",
        "./.github",
        "./methodology",
        "./scripts",
        "./tests",
        "./projects/_template",
        "./projects/*/materials",
        "./projects/*/inbox",
        "./projects/*/state/human.jsonl",
        "./projects/*/traps",
        "./projects/demo-zashchita-blizkih/materials",
        "./projects/demo-zashchita-blizkih/inbox",
        "./projects/demo-zashchita-blizkih/traps"
      ],
      "denyRead": [
        "./.env",
        "./.env.*",
        "~/.ssh",
        "~/.aws"
      ]
    }
  }
}
